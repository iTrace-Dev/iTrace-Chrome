{
  "manifest_version": 3,
  "name": "iTrace-Chrome Plugin",
  "description": "Plugin which allows for tracking eyegaze data on webpages in Chrome.",
  "version": "0.0.1",
  "background": {
    "service_worker": "assets/js/background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": [
    "webNavigation",
    "storage",
    "scripting",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://github.com/*",
    "https://stackoverflow.com/*",
    "*://bugzilla-dev.allizom.org/*",
    "*://bugs.eclipse.org/*",
    "*://bugzilla.mozilla.org/*",
    "*://bugzilla.kernel.org/*",
    "*://bz.apache.org/*"
  ],
  "externally_connectable": {
    "matches": [
      "*://*.stackoverflow.com/**",
      "https://stackoverflow.com/*"
    ]
  }
}
